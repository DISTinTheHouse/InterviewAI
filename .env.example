# Gmail account used by Nodemailer
GMAIL_USER=your-email@gmail.com

# Google App Password; never use the regular account password
GMAIL_APP_PASSWORD=your-16-character-app-password

# Recruiter who receives every completed report
HR_REPORT_EMAIL=recruitment@example.com

# InterviewAI Agency Console v2
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
APP_URL=http://localhost:3000
